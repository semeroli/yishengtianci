# 依赖与产物
node_modules/
dist/

# 🔴 锁文件**故意不提交**。
# 本机这份 lock 只记录了 win32 平台的原生包（@rollup/rollup-win32-x64-msvc、
# @esbuild/win32-x64），没有 linux 变体。仓库里一旦有 lock，Cloudflare 构建会自动
# 改用 `npm ci`，而 npm ci 严格按 lock 安装 —— 到了 Linux 构建机上会报
# `Cannot find module @rollup/rollup-linux-x64-gnu`，构建直接失败。
# 不带 lock，云端就会跑 `npm install`，按当前平台正确解析可选依赖。
# 想恢复可复现安装：删掉本行，并在本地重新 `npm install` 生成完整 lock。
package-lock.json

# 本地数据库（含自测库）与上传的媒体
.data/

# 本地密钥 —— 绝不要提交
.dev.vars
.env
.env.*

# 编辑器与系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Vite 加载 vite.config.js 时会先把它打成临时包，正常会自动删；
# 本机偶发残留（构建中断时），留着会被误提交。
vite.config.js.timestamp-*.mjs

# 后台真机截图产物（npm run shots:admin 生成）
_shots/

# 落地页/局部的真机截图与放大复核产物（_shots-landing.mjs / _crop.mjs / _zoom.mjs 生成）
_shots-landing/
_crop/
_zoom/
/_icon-*.png

# 管理员初始化 SQL（npm run gen-admin 生成）—— 里面有密码散列，绝不提交。
# schema/schema.sql 与 schema/schema.console.sql 是建表脚本，**要**提交；
# 只有 *.local.sql 是本机生成的私密文件。
schema/*.local.sql

# 仓库**根目录**下的本机临时物：_gh_push.mjs、_probe-*.mjs、上线清单等。
# 注意用 / 开头做「根目录锚定」——public/_redirects、public/_headers 是
# Cloudflare Pages 部署必需的配置，**必须**提交，不能被这里漏掉。
/_*.mjs
/_*.txt
/_*.html
/_*.log
/_*.json
